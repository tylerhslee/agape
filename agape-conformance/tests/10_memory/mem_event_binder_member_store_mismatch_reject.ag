//! id:        mem_event_binder_member_store_mismatch_reject
//! section:   10_memory
//! expect:    reject
//! error:     TypeError
//! spec:      §3, §5, §7, §10, §15.3 (a typed event-binder member must match the mem payload type)
//! ---
struct Note { body: text }
event NoteReady(Note note);
agent A {
  mem notes {
    type text;
    modality episodic;
    scope project;
    retention session;
  }
  when (NoteReady ready) { notes <- ready.note; }
}
spawn A a; awake a;
