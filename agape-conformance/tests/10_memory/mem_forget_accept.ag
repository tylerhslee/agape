//! id:        mem_forget_accept
//! section:   10_memory
//! expect:    accept
//! spec:      §10 (forget closes only the current scope tuple generation while the structural descriptor survives)
//! ---
agent A {
  mem notes {
    type text;
    modality opaque;
    scope project;
    retention session;
  }
  on awake {
    notes <- "ephemeral";
    forget notes;
  }
}
spawn A a; awake a;
