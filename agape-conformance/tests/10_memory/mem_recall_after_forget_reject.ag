//! id:        mem_recall_after_forget_reject
//! section:   10_memory
//! expect:    reject
//! error:     TypeError
//! spec:      §10 (forget consumes the mem handle; the region is unrecallable going forward)
//! ---
agent A {
  on awake {
    mem notes <- "ephemeral";
    forget notes;
    text t = notes -> "anything?";
  }
}
spawn A a; awake a;
