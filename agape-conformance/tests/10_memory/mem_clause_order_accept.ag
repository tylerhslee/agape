//! id:        mem_clause_order_accept
//! section:   10_memory
//! expect:    accept
//! contains:  Internalized(notes); MemoryConsulted(notes)
//! order:     Internalized(notes); MemoryConsulted(notes)
//! spec:      §10, §15.3 (descriptor clause order is insignificant)
//! ---
agent A {
  mem notes {
    retention session;
    scope project;
    type text;
    modality opaque;
  }
  on awake {
    notes <- "reordered clauses";
    text[] hits = notes -> "reordered";
    say(hits);
  }
}
spawn A a; awake a;
