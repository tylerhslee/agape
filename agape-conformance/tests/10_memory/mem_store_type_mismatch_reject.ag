//! id:        mem_store_type_mismatch_reject
//! section:   10_memory
//! expect:    reject
//! error:     TypeError
//! spec:      §10, §15.3 (every stored expression must be assignable to the descriptor payload type)
//! ---
agent A {
  mem notes {
    type text;
    modality opaque;
    scope project;
    retention session;
  }
  on awake { notes <- 42; }
}
spawn A a; awake a;
