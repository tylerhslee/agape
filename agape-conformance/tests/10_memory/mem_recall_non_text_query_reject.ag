//! id:        mem_recall_non_text_query_reject
//! section:   10_memory
//! expect:    reject
//! error:     TypeError
//! spec:      §10, §15.3 (the recall query operand is text)
//! ---
agent A {
  mem notes {
    type text;
    modality opaque;
    scope project;
    retention session;
  }
  on awake { text[] hits = notes -> 42; }
}
spawn A a; awake a;
