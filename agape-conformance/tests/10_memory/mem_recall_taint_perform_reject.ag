//! id:        mem_recall_taint_perform_reject
//! section:   10_memory
//! expect:    reject
//! error:     TaintViolation
//! spec:      §10, §13, §16.7 (the exact typed recall array is deeply raw and cannot drive a consequential sink without a gate)
//! ---
action Publish(text[] bodies);
agent A grants { perform Publish } {
  mem note {
    type text;
    modality opaque;
    scope project;
    retention session;
  }
  on awake {
    note <- "remembered draft";
    text[] recalled = note -> "draft";
    perform Publish(recalled);
  }
}
spawn A a; awake a;
