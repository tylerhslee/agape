//! id:        mem_store_records_internalized
//! section:   10_memory
//! expect:    accept
//! contains:  Internalized(notes)
//! spec:      §10, §15.4.2 (a successful explicit typed write records Internalized)
//! ---
agent A {
  mem notes {
    type text;
    modality opaque;
    scope project;
    retention session;
  }
  on awake { notes <- "fact note"; }
}
spawn A a; awake a;
