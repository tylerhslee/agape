//! id:        mem_store_internalizes_ok
//! section:   10_memory
//! expect:    accept
//! spec:      §9, §10 (store(x) is the explicit emphasis form of internalization, on top of the mandatory memory envelope that internalizes every reaction's experience anyway, §16.7)
//! ---
agent A {
  on awake {
    event<text> r = self <- "summarize the day";
    store(r);
  }
}
spawn A a; awake a;
