//! id:        mem_store_internalizes_ok
//! section:   10_memory
//! expect:    accept
//! spec:      §10, §16.7 (mem <- value explicitly internalizes a value into the selected private-memory region)
//! ---
agent A {
  on awake {
    text r = self <- "summarize the day";
    mem notes <- r;
  }
}
spawn A a; awake a;
