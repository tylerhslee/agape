//! id:        mem_store_internalizes_ok
//! section:   10_memory
//! expect:    accept
//! spec:      §10 (the memory write seam mem <- value is the explicit emphasis form of internalization, on top of the mandatory memory envelope that internalizes every reaction, §16.7)
//! ---
agent A {
  on awake {
    text r = self <- "summarize the day";
    mem notes <- r;
  }
}
spawn A a; awake a;
