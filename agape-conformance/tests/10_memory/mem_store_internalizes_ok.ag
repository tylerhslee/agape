//! id:        mem_store_internalizes_ok
//! section:   10_memory
//! expect:    accept
//! spec:      §10 (an explicit write stores a value assignable to the structural descriptor type)
//! ---
agent A {
  mem notes {
    type text;
    modality opaque;
    scope project;
    retention session;
  }
  on awake {
    text r = self <- "summarize the day";
    notes <- r;
  }
}
spawn A a; awake a;
