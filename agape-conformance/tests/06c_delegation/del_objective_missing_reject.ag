//! id:        del_objective_missing_reject
//! section:   06c_delegation
//! expect:    reject
//! error:     TypeError
//! spec:      §6c (a task literal requires BOTH `objective` and `acceptance`)
//! ---
agent Worker {
  on assigned { complete 1; }
}
agent Lead grants { reach Worker } {
  on awake {
    spawn Worker w; awake w;
    int r = w <- task {
      acceptance "an int";
    } expires 10;
  }
}
spawn Lead lead; awake lead;
