//! id:        fn_sync_inhand_verify_ok
//! section:   04_functions
//! expect:    accept
//! spec:      §4, §13 (in-hand verify = decide+emit, synchronous)
//! note:      a sync fn may verify a Credence value already in hand.
//! ---
sync bool over(Credence<bool> c) { verify c; return decide(c, > 0.9); }
