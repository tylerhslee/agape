//! id:        fn_taint_flows_through_call_reject
//! section:   04_functions
//! expect:    reject
//! error:     TaintViolation
//! spec:      §15.3.3 (function calls are trust-transparent; taint flowing through a helper still cannot reach a consequential sink)
//! ---
text id(text value) { return value; }
action Publish(text body);
agent A grants { perform Publish } {
  on awake {
    text draft = self <- "draft a note";
    text through_helper = id(draft);
    perform Publish(through_helper);
  }
}
spawn A a; awake a;
