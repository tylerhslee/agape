//! id:        fn_reject_nonterminal_return
//! section:   04_functions
//! expect:    reject
//! error:     TypeError
//! spec:      §4 (`return` is honored in tail position only — the final statement of a function body; a `return` nested in an `if` is never evaluated and would be silently ignored, so it is a static error, not a runtime no-op)
//! ---
pure int classify(int x) {
  if (x < 0) {
    return 0 - x;          // nested return — never honored; would be silently ignored at runtime
  }
  return x;
}
