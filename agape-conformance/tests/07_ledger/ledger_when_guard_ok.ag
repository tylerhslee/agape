//! id:        ledger_when_guard_ok
//! section:   07_ledger
//! expect:    accept
//! spec:      §7 (a `when … if (guard)` filters by an ordinary predicate over the bound event's fields)
//! ---
event Refund(int amount);
when (Refund r) if (r.amount > 1000) { say("big refund"); }
emit Refund(5000);
