//! id:        ledger_tool_pair
//! section:   07_ledger
//! expect:    accept
//! contains:  pair(Tool@search)
//! spec:      §6b, §7 (a tool call appends a ToolStarted/ToolResolved pair)
//! ---
read tool text search(text q);
agent R grants { use search } {
  text hits = search("agape");
}
spawn R r; awake r;
