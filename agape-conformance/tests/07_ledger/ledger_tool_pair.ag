//! id:        ledger_tool_pair
//! section:   07_ledger
//! expect:    accept
//! contains:  pair(Tool@search)
//! manifest:  tools.search.driver=mock; actions.Search.tool=search
//! spec:      §6b, §7 (a wired perform appends the seam's ToolStarted/ToolResolved journal pair beneath the action's domain row, correlated by catalog name)
//! ---
action Search(text q);
agent R grants { perform Search } {
  on awake { perform Search("agape"); }
}
spawn R r; awake r;
