//! id:        world_perform_unsettled_reject
//! section:   06b_world
//! expect:    reject
//! error:     TaintViolation
//! manifest:  tools.t1.driver=mock; actions.Ask.tool=t1
//! spec:      §6b, §13 (every perform is a consequential sink taking settled args only — anti-exfiltration: un-endorsed cognition never leaves the process on the perform path)
//! ---
action Ask(text q);
agent A grants { perform Ask } {
  on awake {
    text q = self <- "what should we ask the world?";
    perform Ask(q);
  }
}
spawn A a; awake a;
