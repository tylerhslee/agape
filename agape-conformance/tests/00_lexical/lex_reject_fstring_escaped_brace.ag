//! id:        lex_reject_fstring_escaped_brace
//! section:   00_lexical
//! expect:    reject
//! error:     LexError
//! spec:      §2 (f-string escapes are \n \t \" \\ and \${; plain braces are already literal, so \{ is an invalid escape)
//! ---
agent A {
  on awake { say(f"literal \{brace}"); }
}
spawn A a; awake a;
