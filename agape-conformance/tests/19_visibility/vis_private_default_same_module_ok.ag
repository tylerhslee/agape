//! id:        vis_private_default_same_module_ok
//! section:   19_visibility
//! expect:    accept
//! spec:      §19.4 (default-private is module-internal, not decl-internal; siblings see each other)
//! note:      a private helper is visible to another decl in the same module
//! ---
sync int helper() { return 21; }
sync int useit() { return helper() * 2; }
int y = useit();
say(y);
