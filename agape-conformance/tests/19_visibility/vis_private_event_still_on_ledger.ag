//! id:        vis_private_event_still_on_ledger
//! section:   19_visibility
//! expect:    accept
//! contains:  Error
//! modules:   m.ag
//! spec:      §19.4 (a private event still lands on the ledger; caught cross-module by its Error supertype, not its private name)
//! note:      visibility gates the NAME, not ledger presence
//! ---
import m;
agent Watcher { when (Error e) { say("caught"); } }
spawn Watcher v; awake v;
spawn m.Worker w; awake w;
