//! id:        prelude_when_error_catches_contradiction
//! section:   09_prelude
//! expect:    accept
//! spec:      §9 (Contradiction extends Error; when (Error e) catches it by subtype)
//! ---
when (Error e) { say("caught"); }
agent J {
  on awake {
    Credence<Entailment> v = self <- "does \"sky is blue\" entail \"sky is green\"?";
    Decision<Entailment> d = decide v by confidence 0.8;
    if      (d.committed == Entails)     { say("e"); }
    else if (d.committed == Contradicts) { say("c"); }
    else if (d.committed == Neutral)     { say("n"); }
  }
}
spawn J j; awake j;
