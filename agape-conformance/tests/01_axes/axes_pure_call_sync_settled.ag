//! id:        axes_pure_call_sync_settled
//! section:   01_axes
//! expect:    accept
//! spec:      §1 Axis A/B (a pure `sync` fn reaches no dependency and stays `settled`)
//! note:      arithmetic only; provably dependency-free.
//! ---
sync int dbl(int x) { return x * 2; }
int y = dbl(21);
say(f"{y}");
