//! id:        gen_agent_not_generic_reject
//! section:   20_generics
//! expect:    reject
//! error:     ParseError
//! spec:      v1.1.0 design 5.1 (agents are not generic; only struct/fn carry type params)
//! note:      an agent is event-reactive — parameterization lives in its when-handlers' event types
//! ---
agent Worker<T> {
  on awake { say("x"); }
}
