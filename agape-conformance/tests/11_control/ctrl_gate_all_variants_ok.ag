//! id:        ctrl_gate_all_variants_ok
//! section:   11_control
//! expect:    accept
//! spec:      §11, §13 (a gate arm block covering every enum variant is exhaustive)
//! ---
enum Color { Red, Green, Blue }
agent A {
  on awake {
    Credence<Color> c = self <- "what color is grass?";
    decide c by confidence 0.8 {
      Red { say("r"); }
      Green { say("g"); }
      Blue { say("b"); }
    }
  }
}
spawn A a; awake a;
