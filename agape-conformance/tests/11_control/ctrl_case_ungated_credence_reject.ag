//! id:        ctrl_case_ungated_credence_reject
//! section:   11_control
//! expect:    reject
//! error:     TypeError
//! spec:      §3, §11 (a Credence<E> is consumed only by a gate/combinator; an un-gated case is a TypeError — gate it first)
//! ---
enum Color { Red, Green, Blue }
agent A {
  on awake {
    Credence<Color> c = self <- "what color is grass?";
    case (c) as v {
      Red: { say("r"); }
      Green: { say("g"); }
      Blue: { say("b"); }
    }
  }
}
spawn A a; awake a;
