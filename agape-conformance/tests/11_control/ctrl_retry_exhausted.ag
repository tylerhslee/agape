//! id:        ctrl_retry_exhausted
//! section:   11_control
//! expect:    accept
//! provider:  schema_violation
//! contains:  RetryExhausted
//! spec:      §11 (a `{ block } retry(N)` re-attempts on a fault; on exhaustion it emits RetryExhausted and the fault propagates)
//! note:      a persistently schema-violating provider exhausts the bound
//! ---
struct Memo { amount: int, to: text }
agent A {
  on awake {
    {
      event<Memo> m = self <- "extract";
    } retry(2)
  }
}
spawn A a; awake a;
