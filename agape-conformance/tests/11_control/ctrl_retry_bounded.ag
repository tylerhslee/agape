//! id:        ctrl_retry_bounded
//! section:   11_control
//! expect:    accept
//! spec:      §11 (bounded retry re-attempts a verify a fixed number of times)
//! ---
agent A {
  on awake {
    retry(3) {
      Credence<bool> still = self <- "are you ready?";
      verify still;
    }
  }
}
spawn A a; awake a;
