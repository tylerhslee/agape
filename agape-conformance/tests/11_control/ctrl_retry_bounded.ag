//! id:        ctrl_retry_bounded
//! section:   11_control
//! expect:    accept
//! spec:      §11, §15.2 (the only loop is the bounded `{ block } retry(N)`)
//! ---
agent A {
  on awake {
    {
      Credence<bool> still = self <- "are you ready?";
      decide still by confidence 0.9 {
        true { say("ready"); }
        false { say("wait"); }
      }
    } retry(3)
  }
}
spawn A a; awake a;
