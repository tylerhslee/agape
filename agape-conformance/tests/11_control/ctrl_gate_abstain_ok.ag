//! id:        ctrl_gate_abstain_ok
//! section:   11_control
//! expect:    accept
//! spec:      §11, §13 (the `abstained` sentinel is the else case when the gate commits no variant)
//! ---
enum Color { Red, Green, Blue }
agent A {
  on awake {
    Credence<Color> c = self <- "what color is grass?";
    Decision<Color> d = decide c by confidence 0.8;
    if (d.committed == Green) { say("g"); }
    else { say("other"); }
  }
}
spawn A a; awake a;
