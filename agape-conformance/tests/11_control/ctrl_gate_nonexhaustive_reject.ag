//! id:        ctrl_gate_nonexhaustive_reject
//! section:   11_control
//! expect:    reject
//! error:     ExhaustivenessError
//! spec:      §11, §13 (a gate arm block with no abstain must cover all variants)
//! ---
enum Color { Red, Green, Blue }
agent A {
  on awake {
    Credence<Color> c = self <- "what color is grass?";
    decide c by confidence 0.8 {
      Red { say("r"); }
      Green { say("g"); }
    }
  }
}
spawn A a; awake a;
