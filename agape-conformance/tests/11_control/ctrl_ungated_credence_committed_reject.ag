//! id:        ctrl_ungated_credence_committed_reject
//! section:   11_control
//! expect:    reject
//! error:     TypeError
//! spec:      §3, §11 (a Credence<E> is consumed only by a gate/combinator; testing `.committed` before a gate is a TypeError)
//! ---
enum Color { Red, Green, Blue }
agent A {
  on awake {
    Credence<Color> c = self <- "what color is grass?";
    if (c.committed == Green) { say("g"); }
  }
}
spawn A a; awake a;
