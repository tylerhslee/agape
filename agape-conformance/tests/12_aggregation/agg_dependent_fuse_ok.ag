//! id:        agg_dependent_fuse_ok
//! section:   12_aggregation
//! expect:    accept
//! spec:      §12 (a `dependent` declaration fuses conservatively; quorum(1, …) is the at-least-one reduction)
//! ---
agent A {
  on awake {
    Credence<bool> c1 = self <- "is this spam?";
    Credence<bool> c2 = self <- "is this unsolicited?";
    dependent c1, c2;
    Credence<bool> fused = quorum(1, [c1, c2]);
    Decision<bool> d = decide fused by confidence 0.9;
    if (d.committed == true) { say("spam"); }
    else if (d.committed == false) { say("clean"); }
  }
}
spawn A a; awake a;
