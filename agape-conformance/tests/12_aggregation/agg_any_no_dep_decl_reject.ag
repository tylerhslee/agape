//! id:        agg_any_no_dep_decl_reject
//! section:   12_aggregation
//! expect:    reject
//! error:     TypeError
//! spec:      §12 (any over Credence<bool> judges requires total independent/dependent coverage)
//! ---
agent A {
  on awake {
    Credence<bool> a = self <- "is this safe?";
    Credence<bool> b = self <- "is this okay?";
    Credence<bool> c = any(a, b);
  }
}
spawn A a; awake a;
