//! id:        mod_etype_qualified_distinct
//! section:   18_modules
//! expect:    accept
//! modules:   a.ag; b.ag
//! spec:      v1.1.0 design 3.2 (same event name in two modules are DISTINCT qualified etypes)
//! note:      a.Tick and b.Tick coexist; when(a.Tick) binds the qualified type, no collision
//! ---
import a;
import b;
agent Watcher {
  when (a.Tick t) { say("a-tick"); }
}
spawn Watcher w; awake w;
emit a.Tick(1);
emit b.Tick(2);
