//! id:        iface_decl_and_conformance
//! section:   21_interfaces
//! expect:    accept
//! spec:      v1.1.0 design 5.2 (interface decl; an agent nominally conforms via : Iface)
//! ---
event Query(ask: text);
struct Plan { steps: int }
pub interface Planner { handles Query -> Plan; }
agent PM : Planner {
  when (Query q) { say("planning"); }
}
spawn PM p; awake p;
