//! id:        iface_missing_handler_reject
//! section:   21_interfaces
//! expect:    reject
//! error:     InterfaceError
//! spec:      v1.1.0 design 5.2 (a declared interface with no matching handler is an InterfaceError)
//! ---
event Query(ask: text);
struct Plan { steps: int }
interface Planner { when Query decide Plan; }
agent PM : Planner {
  on awake { say("no handler"); }
}
spawn PM p; awake p;
