//! id:        iface_multi_implement
//! section:   21_interfaces
//! expect:    accept
//! spec:      §19.5 (an agent may implement multiple interfaces)
//! ---
event Query(text ask);
event Audit(text what);
struct Plan { steps: int }
struct Report { ok: bool }
interface Planner { when Query decide Plan; }
interface Auditor { when Audit decide Report; }
agent Lead : Planner, Auditor {
  when (Query q) { say("plan"); }
  when (Audit a) { say("audit"); }
}
spawn Lead l; awake l;
