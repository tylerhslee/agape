//! id:        iface_not_instantiable_reject
//! section:   21_interfaces
//! expect:    reject
//! error:     TypeError
//! spec:      v1.1.0 design 5.2 (an interface is a type but not instantiable; spawn of one is a TypeError)
//! ---
event Query(ask: text);
struct Plan { steps: int }
interface Planner { when Query decide Plan; }
spawn Planner p;
