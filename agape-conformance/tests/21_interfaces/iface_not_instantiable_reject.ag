//! id:        iface_not_instantiable_reject
//! section:   21_interfaces
//! expect:    reject
//! error:     TypeError
//! spec:      §19.5 (an interface is a type but not instantiable; spawn of one is a TypeError)
//! ---
event Query(text ask);
struct Plan { steps: int }
interface Planner { when Query decide Plan; }
spawn Planner p;
