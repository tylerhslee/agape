//! id:        iface_subtype_binding
//! section:   21_interfaces
//! expect:    accept
//! spec:      v1.1.0 design 5.2 (agent <: interface; bind a concrete agent to an interface slot; reach over the interface)
//! ---
event Query(ask: text);
struct Plan { steps: int }
interface Planner { handles Query -> Plan; }
agent PM : Planner {
  when (Query q) { say("plan"); }
}
agent Boss grants { reach Planner } {
  on awake {
    spawn PM p; awake p;
    Planner who = p;
    event<null> e = who <- "plan it";
  }
}
spawn Boss b; awake b;
