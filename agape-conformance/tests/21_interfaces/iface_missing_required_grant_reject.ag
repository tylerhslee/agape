//! id:        iface_missing_required_grant_reject
//! section:   21_interfaces
//! expect:    reject
//! error:     InterfaceError
//! spec:      §19.5 (an interface `requires` a capability the implementor lacks)
//! ---
event Query(ask: text);
struct Plan { steps: int }
agent Engineer { on awake { say("eng"); } }
interface Cognition { when Query decide Plan; requires reach Engineer; }
agent PM : Cognition grants { } {
  when (Query q) { say("plan"); }
}
spawn PM p; awake p;
