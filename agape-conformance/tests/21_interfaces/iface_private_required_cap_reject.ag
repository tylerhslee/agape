//! id:        iface_private_required_cap_reject
//! section:   21_interfaces
//! expect:    reject
//! error:     VisibilityError
//! spec:      §19.4, §19.5 (a public interface surface may not expose a private capability target)
//! ---
event Query(ask: text);
struct Plan { steps: int }
agent SecretWorker { on awake { say("secret"); } }
pub interface PublicPlanner {
  when Query decide Plan;
  requires reach SecretWorker;
}
