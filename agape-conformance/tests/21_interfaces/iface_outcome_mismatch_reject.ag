//! id:        iface_outcome_mismatch_reject
//! section:   21_interfaces
//! expect:    reject
//! error:     InterfaceError
//! spec:      §19.5 (interface conformance checks the declared handled event and decided outcome)
//! ---
enum R { Yes, No }
enum S { Ok, Bad }
event Ask(text body);
interface Resolver { when Ask decide R; }
agent Desk : Resolver {
  when (Ask q) {
    Credence<S> c = self <- q.body;
    Decision<S> d = decide c by confidence 0.8;   // produces S, but Resolver requires `decide R`
  }
}
