//! id:        gate_decision_introspection_accept
//! section:   22_gate
//! expect:    accept
//! spec:      §13, §9 (Decision provenance: .basis over the Basis enum)
//! ---
enum R { Yes, No }
event Ask(text body);
agent Desk {
  when (Ask q) {
    Credence<R> c = self <- q.body;
    Decision<R> d = decide c by conformal 0.05;
    if (d.basis == Conformal) { say("conformal"); } else { say("other"); }
  }
  on awake { emit Ask("go"); }
}
spawn Desk d; awake d;
