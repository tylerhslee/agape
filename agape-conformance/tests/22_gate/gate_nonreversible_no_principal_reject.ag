//! id:        gate_nonreversible_no_principal_reject
//! section:   22_gate
//! expect:    reject
//! error:     GateError
//! spec:      §20.3 (a consequential endorsement path with no reachable principal fallback is a compile error)
//! ---
enum R { Approve, Reject }
event Ask(text body);
action Commit(text body);
agent Desk grants { perform Commit } {
  when (Ask q) {
    Credence<R> c = self <- q.body;
    Decision<R> d = decide c by conformal 0.05;
    endorse c by d {
      Approve as e { perform Commit(q.body); }
      Reject as e { say("rejected"); }
    }
  }
}
spawn Desk d; awake d;
