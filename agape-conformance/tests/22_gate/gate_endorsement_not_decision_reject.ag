//! id:        gate_endorsement_not_decision_reject
//! section:   22_gate
//! expect:    reject
//! error:     TypeError
//! spec:      §13 (an Endorsement<E> is not a Decision<E>)
//! ---
enum R { Yes, No }
agent Desk {
  on awake {
    text item = self <- "describe";
    Credence<R> c = self <- f"yes: {item}";
    Decision<R> d = decide c by confidence 0.8;
    Endorsement<text> e = endorse item by d;
    Decision<R> bad = e;
    say(f"{bad}");
  }
}
spawn Desk d; awake d;
