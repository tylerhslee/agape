//! id:        gate_endorsement_introspection_accept
//! section:   22_gate
//! expect:    accept
//! spec:      §20.4 (Endorsement exposes the same read-only provenance fields as Decision)
//! ---
enum R { Yes, No }
agent Desk {
  on awake {
    Credence<R> c = self <- "yes?";
    Decision<R> d = decide c by confidence 0.8;
    endorse c by d {
      Yes as e {
        say(f"{e.committed}");
        case (e.basis) as b {
          Threshold: { say("threshold"); }
          default:   { say("other"); }
        }
        if (e.margin > 0.1) { say("clear"); } else { say("close"); }
      }
      No as e { say("no"); }
    }
  }
}
spawn Desk d; awake d;
