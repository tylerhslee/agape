//! id:        gate_all_reversible_no_principal_accept
//! section:   22_gate
//! expect:    accept
//! contains:  Endorsed
//! spec:      §20.1 (all arms reach reversible sinks -> no principal fallback required)
//! ---
enum R { Ping, Pong }
event Ask(body: text);
reversible write tool bool send(text m)
agent Desk grants { use send } {
  when (Ask q) {
    Credence<R> c = self <- q.body;
    Decision<R> d = decide c by conformal 0.05;
    endorse c by d {
      Ping as e { send("ping"); }
      Pong as e { send("pong"); }
    }
  }
}
spawn Desk d; awake d;
