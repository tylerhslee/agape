//! id:        gate_decide_defer_clause_accept
//! section:   22_gate
//! since:     1.1
//! expect:    accept
//! spec:      §20 (decide with a trailing `defer to p` clause supplies the principal)
//! ---
conformal 0.05;
enum R { Approve, Reject }
event Ask(body: text);
action Commit(body: text)
principal boss;
agent Desk grants { perform Commit } {
  when (Ask q) {
    Credence<R> c = self <- q.body;
    decide c {
      Approve: perform Commit(q.body);
      Reject: say("rejected");
    } defer to boss
  }
}
spawn Desk d; awake d;
