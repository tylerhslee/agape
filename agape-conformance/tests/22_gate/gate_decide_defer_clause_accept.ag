//! id:        gate_decide_defer_clause_accept
//! section:   22_gate
//! expect:    accept
//! principal: grant
//! contains:  PrincipalDecision; Endorsed
//! spec:      §20.3 (deference is an ordinary `decide c by principal` inside the abstain block)
//! ---
conformal 0.05;
enum R { Approve, Reject }
event Ask(body: text);
action Commit(body: text);
principal boss;
agent Desk grants { perform Commit } {
  when (Ask q) {
    Credence<R> c = self <- q.body;
    Decision<R> d = decide c by conformal 0.05;
    endorse c by d {
      Approve as e { perform Commit(q.body); }
      Reject as e { say("rejected"); }
    } abstain {
      Decision<R> h = decide c by boss;
      endorse c by h {
        Approve as e { perform Commit(q.body); }
        Reject as e { say("rejected"); }
      }
    }
  }
}
spawn Desk d; awake d;
