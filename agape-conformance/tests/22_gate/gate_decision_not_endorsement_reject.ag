//! id:        gate_decision_not_endorsement_reject
//! section:   22_gate
//! expect:    reject
//! error:     TypeError
//! spec:      §13 (`decide c by R` yields a Decision<E>, not an Endorsement<E>)
//! ---
enum R { Yes, No }
agent Desk {
  on awake {
    Credence<R> c = self <- "yes?";
    Endorsement<R> e = decide c by confidence 0.8;
    say(f"{e}");
  }
}
spawn Desk d; awake d;
