//! id:        gate_reversible_action_accept
//! section:   22_gate
//! expect:    accept
//! spec:      §20 (`reversible action` — reversibility annotates a perform sink)
//! ---
enum R { A, B }
event Ask(body: text);
reversible action Note(body: text)
agent Desk grants { perform Note } {
  when (Ask q) {
    Credence<R> c = self <- q.body;
    decide c { A: perform Note("a"); B: perform Note("b"); }
  }
}
spawn Desk d; awake d;
