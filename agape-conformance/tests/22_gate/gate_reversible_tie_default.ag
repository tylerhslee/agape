//! id:        gate_reversible_tie_default
//! section:   22_gate
//! expect:    accept
//! provider:  credence(A=0.5, B=0.5)
//! contains:  Review
//! absent:    Note
//! spec:      §20.3 (a reversible decide tie routes to the abstain block instead of silently picking)
//! ---
enum R { A, B }
event Review(text note);
reversible action Note(text body);
agent Desk grants { perform Note } {
  on awake {
    Credence<R> c = self <- "choose A or B";
    Decision<R> d = decide c by conformal 0.1;
    endorse c by d {
      A as e { perform Note("a"); }
      B as e { perform Note("b"); }
    } abstain {
      emit Review("needs-review");
    }
  }
}
spawn Desk d; awake d;
