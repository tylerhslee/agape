//! id:        gate_endorsement_field_readonly_reject
//! section:   22_gate
//! expect:    reject
//! error:     TypeError
//! spec:      §20.4 (Endorsement provenance fields are read-only)
//! ---
enum R { Yes, No }
agent Desk {
  on awake {
    Credence<R> c = self <- "yes?";
    Decision<R> d = decide c by confidence 0.8;
    endorse c by d {
      Yes as e { e.margin = 0.0; }
      No as e  { say("no"); }
    }
  }
}
spawn Desk d; awake d;
