//! id:        gate_endorsement_field_readonly_reject
//! section:   22_gate
//! expect:    reject
//! error:     TypeError
//! spec:      §13 (Endorsement provenance fields are read-only)
//! ---
enum R { Yes, No }
agent Desk {
  on awake {
    text item = self <- "describe";
    Credence<R> c = self <- f"yes: ${item}";
    Decision<R> d = decide c by confidence 0.8;
    if (d.committed == Yes) {
      Endorsement<text> e = endorse item by d;
      e.margin = 0.0;
    }
  }
}
spawn Desk d; awake d;
