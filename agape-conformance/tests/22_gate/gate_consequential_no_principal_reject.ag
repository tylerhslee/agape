//! id:        gate_consequential_no_principal_reject
//! section:   22_gate
//! expect:    reject
//! error:     GateError
//! spec:      §13 (a consequential endorsement path with no principal escalation and no mature profile is a compile error — autonomy is earned, deference is required)
//! ---
enum R { Approve, Reject }
event Ask(text body);
action Commit(text body);
agent Desk grants { perform Commit } {
  when (Ask q) {
    text body = q.body;
    Credence<R> c = self <- f"commit: {body}";
    Decision<R> d = decide c by conformal 0.05;
    Endorsement<text> e = endorse body by d;
    if (e.committed == Approve) { perform Commit(e); }
    else if (e.committed == Reject) { say("rejected"); }
  }
  on awake { emit Ask("go"); }
}
spawn Desk d; awake d;
