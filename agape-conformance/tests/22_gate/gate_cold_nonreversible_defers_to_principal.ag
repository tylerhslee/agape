//! id:        gate_cold_nonreversible_defers_to_principal
//! section:   22_gate
//! expect:    accept
//! provider:  credence(Approve=0.9, Reject=0.1)
//! principal: grant
//! contains:  PrincipalDecision; Endorsed
//! spec:      §20.1, §20.3 (cold non-reversible path reaches a principal before the action arm commits)
//! ---
enum R { Approve, Reject }
action Commit(text body);
principal boss;
agent Desk grants { perform Commit } {
  on awake {
    Credence<R> c = self <- "approve?";
    Decision<R> d = decide c by boss;
    endorse c by d {
      Approve as e { perform Commit("approved"); }
      Reject as e { say("rejected"); }
    }
  }
}
spawn Desk d; awake d;
