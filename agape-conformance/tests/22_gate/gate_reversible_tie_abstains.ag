//! id:        gate_reversible_tie_abstains
//! section:   22_gate
//! expect:    accept
//! provider:  credence(A=0.5, B=0.5)
//! contains:  Abstained(c)
//! absent:    Note
//! spec:      §20.3 (a reversible decide with no plurality and no default abstains; it never silently picks)
//! ---
enum R { A, B }
reversible action Note(text body);
agent Desk grants { perform Note } {
  on awake {
    Credence<R> c = self <- "choose A or B";
    decide c {
      A: perform Note("a");
      B: perform Note("b");
    }
  }
}
spawn Desk d; awake d;
