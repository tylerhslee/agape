//! id:        gate_file_conformal_decl_accept
//! section:   22_gate
//! expect:    accept
//! principal: grant
//! contains:  Endorsed
//! spec:      §13, §15.2 (a file-level `conformal α;` declaration sets the default conformal level)
//! ---
conformal 0.02;
enum R { Yes, No }
event Ask(text body);
action Act(text body);
principal boss;
agent Desk grants { perform Act } {
  when (Ask q) {
    text body = q.body;
    Credence<R> c = self <- f"act: {body}";
    Decision<R> d = boss decide c by conformal 0.02;
    Endorsement<text> e = endorse body by d;
    if (e.committed == Yes) { perform Act(e); }
    else if (e.committed == No) { say("no"); }
  }
  on awake { emit Ask("go"); }
}
spawn Desk d; awake d;
