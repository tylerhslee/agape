//! id:        gate_file_conformal_decl_accept
//! section:   22_gate
//! expect:    accept
//! principal: grant
//! contains:  Endorsed
//! spec:      §20 (file-level `conformal α;` declaration sets the default basis)
//! ---
conformal 0.02;
enum R { Yes, No }
event Ask(text body);
action Act(text body);
principal boss;
agent Desk grants { perform Act } {
  when (Ask q) {
    Credence<R> c = self <- q.body;
    Decision<R> d = boss decide c by conformal 0.02;
    endorse c by d {
      Yes as e { perform Act(q.body); }
      No as e  { say("no"); }
    }
  }
  on awake { emit Ask("go"); }
}
spawn Desk d; awake d;
