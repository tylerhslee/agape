//! id:        gate_per_gate_conformal_accept
//! section:   22_gate
//! expect:    accept
//! principal: grant
//! contains:  Endorsed
//! spec:      §13 (a per-gate conformal α on a decide expression, distinct from the file default)
//! ---
enum R { Yes, No }
event Ask(text body);
action Act(text body);
principal boss;
agent Desk grants { perform Act } {
  when (Ask q) {
    text body = q.body;
    Credence<R> c = self <- f"act on: ${body}";
    Decision<R> d = boss decide c by conformal 0.01;
    if (d.committed == Yes) { Endorsement<text> e = endorse body by d; perform Act(e); }
    else if (d.committed == No) { Endorsement<text> e = endorse body by d; say("no"); }
  }
  on awake { emit Ask("go"); }
}
spawn Desk d; awake d;
