//! id:        gate_per_gate_conformal_accept
//! section:   22_gate
//! expect:    accept
//! contains:  Endorsed
//! spec:      §20 (per-gate conformal α override on a decide expression)
//! ---
enum R { Yes, No }
event Ask(text body);
reversible action Act(text body);
agent Desk grants { perform Act } {
  when (Ask q) {
    Credence<R> c = self <- q.body;
    Decision<R> d = decide c by conformal 0.01;
    endorse c by d {
      Yes as e { perform Act(q.body); }
      No as e  { say("no"); }
    }
  }
  on awake { emit Ask("go"); }
}
spawn Desk d; awake d;
