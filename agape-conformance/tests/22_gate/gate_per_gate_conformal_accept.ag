//! id:        gate_per_gate_conformal_accept
//! section:   22_gate
//! expect:    accept
//! spec:      §20 (per-gate conformal α override on a decide)
//! ---
enum R { Yes, No }
event Ask(body: text);
action Act(body: text)
principal boss;
agent Desk grants { perform Act } {
  when (Ask q) {
    Credence<R> c = self <- q.body;
    boss decide c conformal 0.01 { Yes: perform Act(q.body); No: say("no"); }
  }
}
spawn Desk d; awake d;
