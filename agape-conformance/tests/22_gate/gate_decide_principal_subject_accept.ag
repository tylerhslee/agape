//! id:        gate_decide_principal_subject_accept
//! section:   22_gate
//! expect:    accept
//! principal: grant
//! contains:  PrincipalDecision; Endorsed
//! spec:      §13 (`decide c by p` uses a principal as the decision basis; a non-reversible arm has its reachable principal)
//! ---
conformal 0.05;
enum R { Approve, Reject }
event Ask(body: text);
action Commit(body: text);
principal boss;
agent Desk grants { perform Commit } {
  when (Ask q) {
    Credence<R> c = self <- q.body;
    Decision<R> d = decide c by boss;
    endorse c by d {
      Approve as e { perform Commit(q.body); }
      Reject as e { say("rejected"); }
    }
  }
}
spawn Desk d; awake d;
