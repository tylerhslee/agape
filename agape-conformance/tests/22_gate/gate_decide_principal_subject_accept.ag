//! id:        gate_decide_principal_subject_accept
//! section:   22_gate
//! expect:    accept
//! principal: grant
//! contains:  PrincipalDecision; Endorsed
//! spec:      §13 (`p decide c by r` uses a principal escalation prefix; the endorsed subject reaches the sink in the committed branch)
//! ---
conformal 0.05;
enum R { Approve, Reject }
event Ask(text body);
action Commit(text body);
principal boss;
agent Desk grants { perform Commit } {
  when (Ask q) {
    text body = q.body;
    Credence<R> c = self <- f"commit: {body}";
    Decision<R> d = boss decide c by conformal 0.05;
    if (d.committed == Approve) { Endorsement<text> e = endorse body by d; perform Commit(e); }
    else if (d.committed == Reject) { Endorsement<text> e = endorse body by d; say("rejected"); }
  }
  on awake { emit Ask("go"); }
}
spawn Desk d; awake d;
