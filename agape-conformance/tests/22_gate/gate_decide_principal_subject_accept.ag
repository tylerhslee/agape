//! id:        gate_decide_principal_subject_accept
//! section:   22_gate
//! since:     1.1
//! expect:    accept
//! spec:      §20 (decide with a principal subject; a non-reversible arm has a reachable principal)
//! ---
conformal 0.05;
enum R { Approve, Reject }
event Ask(body: text);
action Commit(body: text)
principal boss;
agent Desk grants { perform Commit } {
  when (Ask q) {
    Credence<R> c = self <- q.body;
    boss decide c {
      Approve: perform Commit(q.body);
      Reject: say("rejected");
    }
  }
}
spawn Desk d; awake d;
