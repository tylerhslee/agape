//! id:        gate_endorsement_expr_type_accept
//! section:   22_gate
//! expect:    accept
//! contains:  Endorsed
//! spec:      §13, §20.4 (the `as e` arm binder has type Endorsement<E>, the recorded form of a gate decision)
//! ---
enum R { Yes, No }
agent Desk {
  on awake {
    Credence<R> c = self <- "yes?";
    Decision<R> d = decide c by confidence 0.8;
    endorse c by d {
      Yes as e { say(f"{e.committed}"); }
      No as e  { say(f"{e.committed}"); }
    }
  }
}
spawn Desk d; awake d;
