//! id:        gate_endorsement_expr_type_accept
//! section:   22_gate
//! expect:    accept
//! contains:  Endorsed
//! spec:      §13 (endorse yields an Endorsement<T>, the recorded settled form of a gate decision)
//! ---
enum R { Yes, No }
agent Desk {
  on awake {
    text item = self <- "describe";
    Credence<R> c = self <- f"yes: {item}";
    Decision<R> d = decide c by confidence 0.8;
    Endorsement<text> e = endorse item by d;
    if (e.committed == Yes) { say(f"{e.committed}"); }
    else if (e.committed == No) { say(f"{e.committed}"); }
  }
}
spawn Desk d; awake d;
