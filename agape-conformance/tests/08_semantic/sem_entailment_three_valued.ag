//! id:        sem_entailment_three_valued
//! section:   08_semantic
//! expect:    accept
//! spec:      §8, §9 (Credence<Entailment> over {Entails, Contradicts, Neutral})
//! ---
agent A {
  on awake {
    Credence<Entailment> v = self <- "does \"sky is blue\" entail \"it is daytime\"?";
    Decision<Entailment> d = decide v by confidence 0.8;
    if      (d.committed == Entails)     { say("e"); }
    else if (d.committed == Contradicts) { say("c"); }
    else if (d.committed == Neutral)     { say("n"); }
  }
}
spawn A a; awake a;
