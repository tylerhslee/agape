//! id:        sem_schema_violation_array_typemismatch
//! section:   08_semantic
//! expect:    accept
//! contains:  TypeMismatch; AgentCrashed(a)
//! order:     TypeMismatch; AgentCrashed
//! provider:  schema_violation
//! spec:      §8, §16.6 (array<T> compiles to schema-constrained output; a schema failure faults the send with TypeMismatch, then the reaction crashes)
//! ---
struct Memo { body: text }
agent A {
  on awake {
    array<Memo> memos = self <- "return memos";
  }
}
spawn A a; awake a;
