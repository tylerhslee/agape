//! id:        sem_contradiction_emits_event
//! section:   08_semantic
//! expect:    accept
//! provider:  credence(Contradicts=0.9, Entails=0.05, Neutral=0.05)
//! contains:  Contradiction(j)
//! spec:      §8, §11 (committing a Credence<Entailment> to Contradicts also emits a first-class Contradiction)
//! ---
agent A {
  on awake {
    Credence<Entailment> j = self <- "does \"the sky is green\" entail \"the sky is blue\"?";
    Decision<Entailment> d = decide j by confidence 0.8;
    if      (d.committed == Entails)     { say("e"); }
    else if (d.committed == Contradicts) { say("c"); }
    else if (d.committed == Neutral)     { say("n"); }
  }
}
spawn A a; awake a;
