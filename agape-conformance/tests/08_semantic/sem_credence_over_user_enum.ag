//! id:        sem_credence_over_user_enum
//! section:   08_semantic
//! expect:    accept
//! spec:      §8 (a provider send bound to Credence<E> is a constrained classifier over E)
//! ---
enum Sentiment { Pos, Neg, Neutral }
agent A {
  on awake {
    Credence<Sentiment> s = self <- "sentiment of: I love this";
    Decision<Sentiment> d = decide s by confidence 0.8;
    if      (d.committed == Pos)     { say("pos"); }
    else if (d.committed == Neg)     { say("neg"); }
    else if (d.committed == Neutral) { say("neu"); }
  }
}
spawn A a; awake a;
