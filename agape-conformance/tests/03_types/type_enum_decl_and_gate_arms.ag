//! id:        type_enum_decl_and_gate_arms
//! section:   03_types
//! expect:    accept
//! spec:      §3, §11, §13 (enum declaration; a gate arm block is exhaustive over all variants)
//! note:      a user enum, judged, gated, and matched exhaustively.
//! ---
enum Ticket { Billing, Bug, Feature }
agent Classifier {
  on awake {
    Credence<Ticket> k = self <- "classify: my card was charged twice";
    decide k by confidence 0.8 {
      Billing { say("billing"); }
      Bug { say("bug"); }
      Feature { say("feature"); }
    }
  }
}
spawn Classifier c; awake c;
