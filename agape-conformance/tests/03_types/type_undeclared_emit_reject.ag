//! id:        type_undeclared_emit_reject
//! section:   03_types
//! expect:    reject
//! error:     TypeError
//! spec:      §3 (events are not self-declaring; emit of an undeclared type is a TypeError)
//! ---
agent A grants { emit Transfer } {
  on awake { emit Transfer("100 to bob"); }
}
spawn A a; awake a;
