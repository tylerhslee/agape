//! id:        type_collapse_requires_rule_reject
//! section:   03_types
//! expect:    reject
//! error:     ParseError
//! spec:      §3, §15.2 (a gate requires its rule; `c by` with no rule is a ParseError)
//! ---
agent A {
  on awake {
    Credence<bool> c = self <- "is this an approval?";
    Decision<bool> b = c by;
  }
}
spawn A a; awake a;
