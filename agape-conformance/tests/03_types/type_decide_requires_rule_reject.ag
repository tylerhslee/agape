//! id:        type_decide_requires_rule_reject
//! section:   03_types
//! expect:    reject
//! error:     ParseError
//! spec:      §3, §15.2 (decide's rule is mandatory)
//! ---
agent A {
  on awake {
    Credence<bool> c = self <- "is this an approval?";
    bool b = decide(c);
  }
}
spawn A a; awake a;
