//! id:        type_undeclared_perform_reject
//! section:   03_types
//! expect:    reject
//! error:     TypeError
//! spec:      §3 (actions are not self-declaring; perform of an undeclared type is a TypeError)
//! ---
agent A grants { * } {
  on awake { perform Refund(25); }
}
spawn A a; awake a;
