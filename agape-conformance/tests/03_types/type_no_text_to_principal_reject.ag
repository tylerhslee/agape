//! id:        type_no_text_to_principal_reject
//! section:   03_types
//! expect:    reject
//! error:     TypeError
//! spec:      §3, §13 (a principal basis must be a declared `principal`, not a string; `decide c by "alice"` has no text -> Principal coercion)
//! ---
agent Drafter {
  on awake {
    Credence<bool> c = self <- "should we send the memo?";
    Decision<bool> d = "alice" decide c by conformal 0.05;
  }
}
spawn Drafter dr; awake dr;
