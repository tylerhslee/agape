//! id:        type_no_text_to_principal_reject
//! section:   03_types
//! expect:    reject
//! error:     TypeError
//! spec:      §3, §13 (a principal prefix must resolve to a declared `principal`, not an ordinary text value)
//! ---
agent Drafter {
  on awake {
    text alice = "alice";
    Credence<bool> c = self <- "should we send the memo?";
    Decision<bool> d = alice decide c by confidence 0.9;
  }
}
spawn Drafter dr; awake dr;
