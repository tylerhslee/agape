//! id:        gov_endorsed_subject_allows_perform
//! section:   13_governance
//! expect:    accept
//! contains:  Endorsed
//! spec:      §13 (endorsing the exact subject settles it; the endorsement is sink-admissible inside a committed branch, licensing a perform)
//! ---
enum Verdict { Faithful, Unsupported }
action Reply(text body);
agent A grants { perform Reply } {
  on awake {
    text draft = self <- "write the answer";
    Credence<Verdict> c = self <- f"is this faithful: {draft}";
    Decision<Verdict> d = decide c by confidence 0.9;
    Endorsement<text> e = endorse draft by d;
    if (e.committed == Faithful) { perform Reply(e); }
    else if (e.committed == Unsupported) { emit Event("revise"); }
  }
}
spawn A a; awake a;
