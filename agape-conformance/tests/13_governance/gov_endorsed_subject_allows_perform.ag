//! id:        gov_endorsed_subject_allows_perform
//! section:   13_governance
//! expect:    accept
//! contains:  Endorsed
//! spec:      §13 (endorsing the exact subject by a sealed Decision settles it inside the matching commit arm, licensing a perform)
//! ---
enum Verdict { Faithful, Unsupported }
action Reply(text body);
agent A grants { perform Reply } {
  on awake {
    text draft = "the answer";
    Credence<Verdict> c = self <- f"is this faithful: {draft}";
    Decision<Verdict> d = decide c by confidence 0.9;
    endorse draft by d {
      Faithful as e { perform Reply(draft); }
      Unsupported as e { emit Event("revise"); }
    }
  }
}
spawn A a; awake a;
