//! id:        gov_certify_negative_arm_taint_reject
//! section:   13_governance
//! expect:    reject
//! error:     TaintViolation
//! spec:      §13 (`certify` settles the artifact only in the certifying verifier arm; negative arms cannot launder raw output)
//! ---
enum Verdict { Faithful, Unsupported }
reversible action Reply(text message);
policy Quality { threshold 0.80 floor 0.10 }

agent Writer grants { perform Reply } {
  on awake {
    text draft = self <- "write a concise answer";
    Credence<Verdict> verdict = self <- f"is this draft faithful? {draft}";
    certify draft by (verdict by Quality) {
      Faithful: perform Reply("safe");
      Unsupported: perform Reply(draft);
    }
  }
}

spawn Writer w;
awake w;
