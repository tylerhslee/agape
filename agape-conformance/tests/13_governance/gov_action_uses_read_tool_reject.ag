//! id:        gov_action_uses_read_tool_reject
//! section:   13_governance
//! expect:    reject
//! error:     TypeError
//! spec:      §3, §6b (`uses` binds an action to a WRITE tool; naming a read tool is a TypeError)
//! ---
read tool text search(text q);
action Find(text q) uses search;
agent A grants { perform Find } {
  on awake { perform Find("x"); }
}
spawn A a; awake a;
