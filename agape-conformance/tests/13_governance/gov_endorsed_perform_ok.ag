//! id:        gov_endorsed_perform_ok
//! section:   13_governance
//! expect:    accept
//! contains:  Endorsed
//! spec:      §13 (a recorded subject endorsement licenses a consequential perform in its committed branch)
//! ---
enum R { Fraud, Clean }
action Flag(bool b);
agent C grants { perform Flag } {
  on awake {
    text report = self <- "describe the transaction";
    Credence<R> c = self <- f"is this fraud: {report}";
    Decision<R> d = decide c by confidence 0.9 margin 0.2;
    if (d.committed == Fraud) { Endorsement<text> e = endorse report by d; perform Flag(true); }
    else if (d.committed == Clean) { Endorsement<text> e = endorse report by d; }
  }
}
spawn C c; awake c;
