//! id:        gov_certify_artifact_allows_perform
//! section:   13_governance
//! expect:    accept
//! contains:  Certified(draft)
//! contains:  Reply(ok)
//! spec:      §13 (`certify` records artifact endorsement and settles the exact artifact in the positive verifier arm)
//! ---
enum Verdict { Faithful, Unsupported, NeedsRewrite }
reversible action Reply(text message);
policy Quality { threshold 0.80 floor 0.10 }

agent Writer grants { perform Reply } {
  on awake {
    text draft = self <- "write a concise answer";
    Credence<Verdict> verdict = self <- f"is this draft faithful? {draft}";
    certify draft by (verdict by Quality) {
      Faithful: perform Reply(draft);
      Unsupported: perform Reply("not verified");
      NeedsRewrite: perform Reply("rewrite needed");
    } abstain {
      perform Reply("verification abstained");
    }
  }
}

spawn Writer w;
awake w;
