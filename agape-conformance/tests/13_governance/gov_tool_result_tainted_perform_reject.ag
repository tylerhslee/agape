//! id:        gov_tool_result_tainted_perform_reject
//! section:   13_governance
//! expect:    reject
//! error:     TaintViolation
//! spec:      §6b, §13 (a tool result carries the join of its inputs' trust; a cognition-derived input is un-settled → cannot drive a consequential perform without a gate)
//! ---
action Alarm(text msg);
read tool text fetch(text url);
agent Mon grants { use fetch, perform Alarm } {
  on awake {
    text ep = self <- "which endpoint is down?";
    text body = fetch(f"{ep}");
    perform Alarm(body);
  }
}
spawn Mon m; awake m;
