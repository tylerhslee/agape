//! id:        gov_certify_bare_decision_reject
//! section:   13_governance
//! expect:    reject
//! error:     TypeError
//! spec:      §13 (`certify artifact by e` requires Endorsement<E>, rejecting an off-ledger bare Decision from `c by R`)
//! ---
enum Verdict { Faithful, Unsupported }
reversible action Reply(text message);
policy Quality { threshold 0.80 floor 0.10 }

agent Writer grants { perform Reply } {
  on awake {
    text draft = self <- "write a concise answer";
    Credence<Verdict> verdict = self <- f"is this draft faithful? {draft}";
    Decision<Verdict> ok = verdict by Quality;
    certify draft by ok {
      Faithful: perform Reply(draft);
      Unsupported: perform Reply("not verified");
    }
  }
}

spawn Writer w;
awake w;
