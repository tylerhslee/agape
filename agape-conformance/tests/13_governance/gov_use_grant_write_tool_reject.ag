//! id:        gov_use_grant_write_tool_reject
//! section:   13_governance
//! expect:    reject
//! error:     TypeError
//! spec:      §6b, §13 (a `use` grant naming a write tool is illegal — the corresponding power is `perform` on a bound action)
//! ---
write tool bool transfer(int amount, text to);
agent Bank grants { use transfer } {
  on awake { say("never runs"); }
}
spawn Bank b; awake b;
