//! id:        gov_attest_records_attestation
//! section:   13_governance
//! expect:    accept
//! contains:  Attestation(m)
//! spec:      §13, §16.4 (a granted attest records an Attestation event for the gated value)
//! ---
principal alice;
agent Drafter {
  on awake {
    event<text> m = self <- "draft the refund memo";
    attest m by alice;
  }
}
spawn Drafter d; awake d;
