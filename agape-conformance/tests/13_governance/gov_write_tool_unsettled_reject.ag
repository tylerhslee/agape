//! id:        gov_write_tool_unsettled_reject
//! section:   13_governance
//! expect:    reject
//! error:     TaintViolation
//! spec:      §6b, §13 (a write tool is a consequential sink; a cognition-derived input is un-settled → reject)
//! ---
write tool bool transfer(int amount, text to);
agent Bank grants { use transfer } {
  on awake {
    text who = self <- "who should we pay?";
    bool ok = transfer(100, f"{who}");
  }
}
spawn Bank b; awake b;
