//! id:        gov_attester_verified_resumes
//! section:   13_governance
//! expect:    accept
//! principal: grant
//! attester:  alice
//! manifest:  security.attesters.alice.driver=host
//! contains:  PendingPrincipalDecision; PrincipalDecision; Endorsed; Decided
//! spec:      §13, §17.7 (a host authenticator is bound; the attested ruling's verified identity resolves to the deferred principal, so the attester-match passes, PrincipalDecision is recorded, and the reaction resumes through endorse to the sink)
//! ---
enum Approval { Approve, Decline }
action ReleaseFunds(int cents);
principal alice;
agent Clerk grants { perform ReleaseFunds } {
  on awake {
    text req = self <- "state the refund request";
    Credence<Approval> c = self <- f"assess: ${req}";
    Decision<Approval> d = alice decide c by conformal 0.05;
    if (d.committed == Approve) { Endorsement<text> e = endorse req by d; perform ReleaseFunds(10000); }
    else if (d.committed == Decline) { Endorsement<text> e = endorse req by d; say("declined"); }
    else { say("awaiting attestation"); }
  }
}
spawn Clerk a; awake a;
