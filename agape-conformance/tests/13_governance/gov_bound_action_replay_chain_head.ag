//! id:        gov_bound_action_replay_chain_head
//! section:   13_governance
//! expect:    accept
//! contains:  pair(Tool@transfer)
//! replay:    chain_head_equal
//! spec:      §16.5 (recorded replay of a bound action's write tool regenerates the same chain-head from journaled tool results)
//! ---
write tool bool transfer(int amount);
action Pay(int amount) uses transfer;
agent A grants { perform Pay } {
  on awake { perform Pay(5); }
}
spawn A a; awake a;
