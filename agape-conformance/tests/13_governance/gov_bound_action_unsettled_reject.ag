//! id:        gov_bound_action_unsettled_reject
//! section:   13_governance
//! expect:    reject
//! error:     TaintViolation
//! spec:      §6b, §13 (a bound action's perform is the write tool's only entrance and is a consequential sink; a cognition-derived argument is un-settled → reject)
//! ---
write tool bool transfer(int amount, text to);
action Pay(int amount, text to) uses transfer;
agent Bank grants { perform Pay } {
  on awake {
    text who = self <- "who should we pay?";
    perform Pay(100, who);
  }
}
spawn Bank b; awake b;
