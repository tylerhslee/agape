//! id:        gov_consequential_bare_collapse_reject
//! section:   13_governance
//! expect:    reject
//! error:     TaintViolation
//! spec:      §13 (a sealed Decision may guide control flow but is not a subject endorsement → it may not license a perform)
//! note:      only a recorded subject endorsement (endorse) may license a consequential action.
//! ---
enum R { Fraud, Clean }
action Flag(text body);
agent C grants { perform Flag } {
  on awake {
    text body = self <- "draft the report body";
    Credence<R> c = self <- f"is this fraud: {body}";
    Decision<R> d = decide c by confidence 0.9;
    if (d.committed == Fraud) { perform Flag(body); }
  }
}
spawn C c; awake c;
