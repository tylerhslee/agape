//! id:        gov_negative_arm_taint_reject
//! section:   13_governance
//! expect:    reject
//! error:     TaintViolation
//! spec:      §13 (endorse settles the subject only in its matching commit arm; a non-endorsing arm cannot launder the raw artifact into a perform)
//! ---
enum Verdict { Faithful, Unsupported }
action Reply(text body);
agent A grants { perform Reply } {
  on awake {
    text draft = "the answer";
    Credence<Verdict> c = self <- f"is this faithful: {draft}";
    Decision<Verdict> d = decide c by confidence 0.9;
    endorse draft by d {
      Faithful as e { perform Reply("safe"); }
      Unsupported as e { perform Reply(draft); }
    }
  }
}
spawn A a; awake a;
