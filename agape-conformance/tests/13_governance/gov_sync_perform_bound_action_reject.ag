//! id:        gov_sync_perform_bound_action_reject
//! section:   13_governance
//! expect:    reject
//! error:     ColorViolation
//! spec:      §6b (a tool call reaches the tool dependency → async; a `sync` function may not perform a tool-BOUND action)
//! ---
write tool bool transfer(int amount);
action Pay(int amount) uses transfer;
sync null payFive() {
  perform Pay(5);
  return;
}
agent A grants { perform Pay } {
  on awake { payFive(); }
}
spawn A a; awake a;
