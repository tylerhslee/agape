//! id:        gov_conformal_gate_ok
//! section:   13_governance
//! expect:    accept
//! spec:      §13 (the conformal basis `by conformal α` is a distribution-free finite-sample gate calibrated from the ledger)
//! ---
enum Ticket { Billing, Bug, Feature }
agent A {
  on awake {
    Credence<Ticket> k = self <- "classify: my card was charged twice";
    Decision<Ticket> d = decide k by conformal 0.1;
    endorse k by d {
      Billing as e { }
      Bug as e { }
      Feature as e { }
    } abstain { emit Event("escalate"); }
  }
}
spawn A a; awake a;
