//! id:        gov_attester_wrong_principal_rejected
//! section:   13_governance
//! expect:    accept
//! principal: grant
//! attester:  mallory
//! manifest:  security.attesters.alice.driver=host
//! contains:  PendingPrincipalDecision; FailedPrincipalDecision; Decided
//! absent:    PrincipalDecision; Endorsed
//! spec:      §13, §16.4 (a host authenticator is bound; the attested ruling's verified identity resolves to a DIFFERENT principal than the gate deferred to, so the attester-match rejects the ruling — FailedPrincipalDecision, the decision stays abstained, fail-closed, and no subject reaches the sink)
//! ---
enum Approval { Approve, Decline }
action ReleaseFunds(int cents);
principal alice;
agent Clerk grants { perform ReleaseFunds } {
  on awake {
    text req = self <- "state the refund request";
    Credence<Approval> c = self <- f"assess: ${req}";
    Decision<Approval> d = alice decide c by conformal 0.05;
    if (d.committed == Approve) { Endorsement<text> e = endorse req by d; perform ReleaseFunds(10000); }
    else if (d.committed == Decline) { Endorsement<text> e = endorse req by d; say("declined"); }
    else { say("rejected attester — awaiting a verified ruling"); }
  }
}
spawn Clerk a; awake a;
