//! id:        gov_gate_unknown_arm_reject
//! section:   13_governance
//! expect:    reject
//! error:     TypeError
//! spec:      §13, §15.3.3 (gate arm heads must be variants of the gate enum, or true/false for bool)
//! ---
enum Verdict { Publish, Revise }
agent A {
  on awake {
    Credence<Verdict> c = self <- "publish?";
    decide c by confidence 0.9 {
      Publish { say("publish"); }
      Revise { say("revise"); }
      Unknown { say("unknown"); }
    }
  }
}
spawn A a; awake a;
