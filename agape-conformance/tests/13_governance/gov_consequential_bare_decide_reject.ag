//! id:        gov_consequential_bare_decide_reject
//! section:   13_governance
//! expect:    reject
//! error:     TaintViolation
//! spec:      §13 (a bare decide is committed but NOT authorized → reject at a consequential emit)
//! ---
authority Flag;
event Flag(bool b);
agent C grants { emit Flag } {
  on awake {
    Credence<bool> c = self <- "is this fraud?";
    bool d = decide(c, > 0.9);
    emit Flag(d);
  }
}
spawn C c; awake c;
