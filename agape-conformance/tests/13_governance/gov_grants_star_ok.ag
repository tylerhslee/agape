//! id:        gov_grants_star_ok
//! section:   13_governance
//! expect:    accept
//! contains:  Endorsed
//! spec:      §13 (grants { * } is the explicit unconstrained opt-out — lattice top)
//! ---
enum R { Pay, Hold }
action Disburse(int amount);
agent A grants { * } {
  on awake {
    text req = self <- "state the payment request";
    Credence<R> c = self <- f"should we pay: {req}";
    Decision<R> d = decide c by confidence 0.9;
    Endorsement<text> e = endorse req by d;
    if (e.committed == Pay) { perform Disburse(100); }
    else if (e.committed == Hold) { }
  }
}
spawn A a; awake a;
