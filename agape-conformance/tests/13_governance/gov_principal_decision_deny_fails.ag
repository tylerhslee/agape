//! id:        gov_principal_decision_deny_fails
//! section:   13_governance
//! expect:    accept
//! principal: deny
//! contains:  FailedPrincipalDecision
//! spec:      §13 (when the principal declines, `p decide c by r` records a FailedPrincipalDecision and the decision stays abstained)
//! ---
enum Approval { Approve, Decline }
action ReleaseFunds(int cents);
principal alice;
agent Clerk grants { perform ReleaseFunds } {
  on awake {
    text req = self <- "state the refund request";
    Credence<Approval> c = self <- f"assess: {req}";
    Decision<Approval> d = alice decide c by conformal 0.05;
    Endorsement<text> e = endorse req by d;
    if (e.committed == Approve) { perform ReleaseFunds(10000); }
    else if (e.committed == Decline) { say("declined"); }
    else { say("principal declined to rule"); }
  }
}
spawn Clerk a; awake a;
