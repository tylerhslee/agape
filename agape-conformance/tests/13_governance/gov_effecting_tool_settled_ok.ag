//! id:        gov_effecting_tool_settled_ok
//! section:   13_governance
//! expect:    accept
//! spec:      §6b, §13 (an effecting tool called with settled inputs is permitted)
//! ---
effecting tool bool transfer(int amount, text to);
agent Bank grants { use transfer } {
  on awake {
    bool ok = transfer(100, "bob");
  }
}
spawn Bank b; awake b;
