//! id:        gov_endorse_abstain_sink_reject
//! section:   13_governance
//! expect:    reject
//! error:     TaintViolation
//! spec:      §13, §15.3.3 (an Endorsement is sink-admissible only in a committed-variant branch, not in abstain)
//! ---
enum Verdict { Publish, Revise }
action PublishMemo(text body);
agent A grants { perform PublishMemo } {
  on awake {
    text body = self <- "draft memo";
    Credence<Verdict> c = self <- f"is ready: {body}";
    Decision<Verdict> d = decide c by confidence 0.9 margin 0.2;
    endorse body by d {
      Publish as e { say("ok"); }
      Revise { say("revise"); }
    } abstain as e {
      perform PublishMemo(e);
    }
  }
}
spawn A a; awake a;
