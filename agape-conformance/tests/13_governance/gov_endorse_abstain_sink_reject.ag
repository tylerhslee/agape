//! id:        gov_endorse_abstain_sink_reject
//! section:   13_governance
//! expect:    reject
//! error:     TypeError
//! spec:      §13, §15.3.3 (abstinence is a Decision outcome, not an Endorsement; endorse requires a committed-narrowed Decision)
//! ---
enum Verdict { Publish, Revise }
action PublishMemo(text body);
agent A grants { perform PublishMemo } {
  on awake {
    text body = self <- "draft memo";
    Credence<Verdict> c = self <- f"is ready: {body}";
    Decision<Verdict> d = decide c by confidence 0.9 margin 0.2;
    if (d.committed == Publish) { Endorsement<text> e = endorse body by d; say("ok"); }
    else if (d.committed == Revise) { Endorsement<text> e = endorse body by d; say("revise"); }
    else {
      Endorsement<text> e = endorse body by d;
      perform PublishMemo(e);
    }
  }
}
spawn A a; awake a;
