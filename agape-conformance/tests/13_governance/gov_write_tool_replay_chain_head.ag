//! id:        gov_write_tool_replay_chain_head
//! section:   13_governance
//! expect:    accept
//! contains:  pair(Tool@transfer)
//! replay:    chain_head_equal
//! spec:      §16.5 (recorded replay of a write tool regenerates the same chain-head from journaled tool results)
//! ---
write tool bool transfer(int amount);
agent A grants { use transfer } {
  on awake { transfer(5); }
}
spawn A a; awake a;
