//! id:        cfg_missing_tool_binding_reject
//! section:   16_config
//! expect:    reject
//! error:     ConfigError
//! spec:      §17.1 (each tool declaration resolves to a configured world capability; an unbound declared dependency is ALWAYS a ConfigError, not a late runtime lookup — no opt-in flag)
//! ---
read tool text search(text q);
agent A grants { use search } {
  on awake { search("agape"); }
}
spawn A a; awake a;
