//! id:        cfg_strict_bindings_ok
//! section:   16_config
//! expect:    accept
//! manifest:  identity.alice.driver=local_keyring; prompts.question.driver=stdin; tools.search.driver=mock; actions.Search.tool=search
//! spec:      §17.1 (declared dependencies pass configuration binding when every dependency has a manifest entry and every wiring references an existing catalog key and a declared name)
//! ---
principal alice;
prompt text question;
action Search(text q);
agent A grants { perform Search } {
  on awake { perform Search("agape"); }
}
spawn A a; awake a;
