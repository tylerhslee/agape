//! id:        cfg_strict_bindings_ok
//! section:   16_config
//! expect:    accept
//! manifest:  identity.alice.driver=local_keyring; prompts.question.driver=stdin; tools.search.driver=mock
//! spec:      §17.1 (declared dependencies pass configuration binding when every dependency has a manifest entry)
//! ---
principal alice;
prompt text question;
read tool text search(text q);
agent A grants { use search } {
  on awake { search("agape"); }
}
spawn A a; awake a;
