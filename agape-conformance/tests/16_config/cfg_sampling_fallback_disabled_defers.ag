//! id:        cfg_sampling_fallback_disabled_defers
//! section:   16_config
//! expect:    accept
//! manifest:  provider.exposes_logprobs=false; provider.sampling_fallback=false
//! contains:  Decided
//! absent:    Endorsed
//! spec:      §13, §17 (without logprobs or the sampling fallback, a conformal gate has no distribution and degrades to deferral/abstain)
//! ---
enum R { Yes, No }
agent A {
  on awake {
    text req = self <- "state the request";
    Credence<R> c = self <- f"yes: ${req}";
    Decision<R> d = decide c by conformal 0.05;
    if (d.committed == Yes) { Endorsement<text> e = endorse req by d; say("yes"); }
    else if (d.committed == No) { Endorsement<text> e = endorse req by d; say("no"); }
    else { say("defer"); }
  }
}
spawn A a; awake a;
