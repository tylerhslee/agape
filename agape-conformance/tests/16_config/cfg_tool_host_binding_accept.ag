//! id:        cfg_tool_host_binding_accept
//! section:   16_config
//! expect:    accept
//! manifest:  tools.search.driver=host; tools.search.adapter=localSearch; actions.Search.tool=search
//! spec:      §6b, §17.1 (a [tools.*] catalog entry can bind to implementation-defined host functions, scripts, processes, or skills; the wiring is unchanged)
//! ---
action Search(text q);
agent A {
  on awake { say("configured"); }
}
spawn A a; awake a;
