//! id:        cfg_tool_mcp_binding_accept
//! section:   16_config
//! expect:    accept
//! manifest:  tools.search.driver=mcp; tools.search.server=stdio:local-search; actions.Search.tool=search
//! spec:      §6b, §17.1 ([tools.*] is the endpoint catalog and MCP is one supported transport; an action wires to a catalog entry by its key)
//! ---
action Search(text q);
agent A {
  on awake { say("configured"); }
}
spawn A a; awake a;
