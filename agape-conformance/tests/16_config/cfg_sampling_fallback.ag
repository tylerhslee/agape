//! id:        cfg_sampling_fallback
//! section:   16_config
//! expect:    accept
//! manifest:  provider.exposes_logprobs=false; provider.fallback_samples=10; provider.fallback_temperature=0.7
//! provider:  credence(true=0.9, false=0.1)
//! contains:  Endorsed(ready)
//! spec:      §16.8, §17 (a text-only provider — no logprobs — is served by the sampling fallback: the credence is the empirical frequency of N forced draws; a confident judgment still commits)
//! note:      the manifest sets only connector config; the decision policy is in source
//! ---
policy Conf { threshold 0.8 }
agent A {
  on awake {
    Credence<bool> c = self <- "ready?";
    Decision<bool> d = decide c by Conf;
    endorse "ready" by d {
      true { say("ready"); }
      false { say("not-ready"); }
    }
  }
}
spawn A a; awake a;
