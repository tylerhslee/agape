//! id:        cfg_sampling_fallback
//! section:   16_config
//! expect:    accept
//! manifest:  provider.exposes_logprobs=false; provider.fallback_samples=10; provider.fallback_temperature=0.7
//! provider:  credence(true=0.9, false=0.1)
//! contains:  Endorsed
//! spec:      §16.8, §17 (a text-only provider is served by the sampling fallback: the credence is the empirical frequency of N forced draws; a confident judgment still commits)
//! note:      the manifest sets only connector config; the decision rule is in source
//! ---
agent A {
  on awake {
    text item = self <- "state readiness";
    Credence<bool> c = self <- f"ready: {item}";
    Decision<bool> d = decide c by confidence 0.8;
    Endorsement<text> e = endorse item by d;
    if (e.committed == true) { say("ready"); }
    else if (e.committed == false) { say("not-ready"); }
  }
}
spawn A a; awake a;
