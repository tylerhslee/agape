//! id:        repro_chain_head_equal
//! section:   15_reproducibility
//! expect:    accept
//! replay:    chain_head_equal
//! spec:      §15.4.2, §15.5 / T4 (a recorded run replays to an identical chain-head: every oracle result is re-served from the journal in order and nothing is re-invoked)
//! ---
action Flag(bool b);
agent A grants { perform Flag } {
  on awake {
    text note = self <- "describe";
    Credence<bool> c = self <- f"flag it: ${note}";
    Decision<bool> d = decide c by confidence 0.9;
    if (d.committed == true) { Endorsement<text> e = endorse note by d; perform Flag(true); }
    else if (d.committed == false) { Endorsement<text> e = endorse note by d; }
  }
}
spawn A a; awake a;
