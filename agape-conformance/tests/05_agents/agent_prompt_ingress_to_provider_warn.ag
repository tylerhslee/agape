//! id:        agent_prompt_ingress_to_provider_warn
//! section:   05_agents
//! expect:    accept
//! warning:   tainted_ingress_to_provider
//! manifest:  prompts.question.driver=stdin
//! spec:      §5b, §17 (default provider-prompt ingress policy warns when judgment-settled but unscreened prompt ingress is interpolated into cognition)
//! ---
prompt text question;
agent A {
  when (Prompt p about question) {
    text draft = self <- f"answer using the user request: ${p.text}";
    say(draft);
  }
}
spawn A a; awake a;
