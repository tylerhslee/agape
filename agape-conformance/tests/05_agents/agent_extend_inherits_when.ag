//! id:        agent_extend_inherits_when
//! section:   05_agents
//! expect:    accept
//! spec:      §5, §7 (extend inherits fields + constructor + when blocks + hooks)
//! note:      the child inherits Base's typed when subscription.
//! ---
event Ping(text msg);
agent Base {
  when (Ping p) { say("base reacted"); }
}
agent Child {
  extend Base();
}
spawn Child c; awake c;
