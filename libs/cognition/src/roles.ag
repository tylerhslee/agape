module cognition.roles;

import { Cognition } from cognition;
import { Asked, Ruled, Concluded, Verdict, Insight, Stance, Escalate } from cognition.signals;

// A role archetype = a function priority + an authority (grants). Each role is an ordinary
// agent satisfying the Cognition contract; its "type" (MBTI sense) is which functions
// dominate. (Grants appear on roles that `perform`/`reach`; this critic only judges + emits.)

// Reviewer — a Ti/Si-dominant critic: checks internal consistency, low tolerance for doubt.
pub agent Reviewer : Cognition {
  when (Asked a) {
    Credence<Stance> c = self <- a.query.ask;       // Ti: is this internally consistent?
    endorse (c by confidence 0.85) {
      Affirm: {
        emit Ruled(Verdict { committed: true, rationale: "consistent" });   // settled export
        emit Concluded(Insight { summary: a.query.ask });                   // feed the PFC
      }
      Deny: { emit Ruled(Verdict { committed: false, rationale: "inconsistent" }); }
    } abstain {
      emit Escalate("reviewer: ambiguous");          // Fe: defer to the responsible party
    };
  }
}
