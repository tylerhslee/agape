module cognition.consolidator;

import { Appraise, Ruled, Ruling, Escalate } from cognition;
import { Faculty } from cognition.faculty;

// The prefrontal cortex. Holds a panel of Faculties (constructor-bound), fans the same
// proposition to all, fuses their INDEPENDENT judgments with quorum, and gates ONCE. This is
// the ONLY producer of a settled Ruling — a single faculty's Credence is graded and cannot
// drive an action (§13). The fused margin exceeds any single faculty's, so the ruling is
// provably more stable than any part (§15.5.5): the whole beats the sum.
//
// This 3-faculty panel is the minimal shape; widen the constructor + fan-out + quorum array to
// add lenses. quorum/all REQUIRE the dependence declaration (§12); the library cannot PROVE the
// lenses are independent (the type system can't, §12), so the claim is asserted here and
// validated empirically by the ablation harness (DESIGN.md §5).

policy PanelQuorum { threshold 0.9 }

pub agent Consolidator(Faculty f1, Faculty f2, Faculty f3) grants { reach Faculty } {
  when (Appraise a) {
    Credence<bool> j1 = f1 <- f"{a.c.proposition} (context: {a.c.context})";  // each lens judges
    Credence<bool> j2 = f2 <- f"{a.c.proposition} (context: {a.c.context})";  // the same proposition
    Credence<bool> j3 = f3 <- f"{a.c.proposition} (context: {a.c.context})";  // independently
    independent j1, j2, j3;                           // assert the lenses are decorrelated (§12)
    Credence<bool> fused = quorum(2, [j1, j2, j3]);   // 2-of-3 fusion — margin tightens (§15.5.5)
    endorse (fused by PanelQuorum) {
      true:  { emit Ruled(Ruling { passed: true,  rationale: "panel quorum: pass" }); }
      false: { emit Ruled(Ruling { passed: false, rationale: "panel quorum: fail" }); }
    } abstain {
      emit Escalate("panel split: no quorum");        // defer the genuinely contested case
    };
  }
}
