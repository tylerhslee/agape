{
  "name": "agape",
  "displayName": "Agape",
  "description": "Syntax highlighting for the Agape language (v1.0). Works in VS Code and Cursor.",
  "version": "0.1.0",
  "publisher": "agape-lang",
  "license": "SEE LICENSE IN ../../README.md",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "agape",
    "agentic",
    "ai",
    "multi-agent"
  ],
  "contributes": {
    "languages": [
      {
        "id": "agape",
        "aliases": [
          "Agape",
          "agape"
        ],
        "extensions": [
          ".ag"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "agape",
        "scopeName": "source.agape",
        "path": "./syntaxes/agape.tmLanguage.json"
      }
    ]
  }
}
