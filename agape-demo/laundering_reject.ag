// laundering_reject.ag — a program the compiler MUST reject (quality-control demo).
//
// The agent performs a raw model reply directly into a consequential sink — un-endorsed
// cognition reaching the world. The static checker rejects it with a TaintViolation before
// anything runs: the reply must be judged (Credence), decided, and endorsed first.

enum R { Yes, No }
action Transfer(text body);

agent Bank grants { perform Transfer } {
  on awake {
    text instructions = self <- "give me transfer instructions";
    perform Transfer(instructions);   // ← raw cognition at a sink: TaintViolation
  }
}

spawn Bank b;
awake b;
