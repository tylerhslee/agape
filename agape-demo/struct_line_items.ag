// struct_line_items.ag
//
// Struct[] compiles to a structured provider schema. The array's struct
// fields remain addressable in Agape.
//
// Run from the repo root:
//   npx tsx agape-ts/src/cli.ts run agape-demo/struct_line_items.ag

struct LineItem {
  sku: text,
  quantity: int,
  price_cents: int
}

agent InvoiceReader {
  on awake {
    LineItem[] items =
      self <- "Extract invoice line items from: 2 AX-10 at $9.99, 1 BX-20 at $14.50.";

    say(items[0].sku);
    say(f"quantity: {items[0].quantity}");
  }
}

spawn InvoiceReader reader;
awake reader;
