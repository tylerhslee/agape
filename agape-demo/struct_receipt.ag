// struct_receipt.ag
//
// A declared struct on the left-hand side of `<-` forces a structured provider
// reply for that exact object shape.
//
// Run from the repo root:
//   npx tsx agape-ts/src/cli.ts run agape-demo/struct_receipt.ag

struct Receipt {
  vendor: text,
  total_cents: int,
  needs_review: bool
}

agent Extractor {
  on awake {
    Receipt receipt =
      self <- "Extract a receipt: vendor Northwind, total $41.25, no review needed.";

    say(receipt.vendor);
    say(f"total cents: {receipt.total_cents}");
    say(f"needs review: {receipt.needs_review}");
  }
}

spawn Extractor extractor;
awake extractor;
