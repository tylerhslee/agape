// attest_wire.ag — the principal attestation flow, live.
//
// A treasurer extracts a wire request (a typed struct: amount + memo), judges it on a COLD
// conformal gate (no calibration labels yet), so the rule can never commit autonomously —
// every run escalates to the principal `boss` through the identity dependency (§13/§16.4).
// Studio pauses the run and asks YOU to rule: choose one of the enum's variants
// (Approve / Deny), or decline to rule.
//
//   rule abstains (cold) ─► consult boss ─► your ruling arrives as a VARIANT
//     Approve  → PrincipalDecision → Decided(Approve) → endorse → WireFunds(e.amount_cents)
//     Deny     → PrincipalDecision → Decided(Deny)    → no sink
//     decline  → FailedPrincipalDecision → Decided(abstained) → withheld (fail closed),
//                and NO calibration label — a refusal to rule is not evidence
//
// Nothing at the sink is hard-coded: the amount that moves is a field OF THE ENDORSED
// SUBJECT (`e.amount_cents`) — the settled value the ruling was actually about.

enum Approval { Approve, Deny }

struct Wire { amount_cents: int, memo: text }

event  Wired(text note);
action WireFunds(int cents);        // the consequential sink

principal boss;

agent Treasurer grants { perform WireFunds } {
  on awake {
    Wire request = self <- "extract the incoming wire request: amount in cents, and a short memo";

    Credence<Approval> c = self <- f"should we wire {request.amount_cents} cents for: {request.memo}";
    Decision<Approval>  d = boss decide c by conformal 0.05;

    if (d.committed == Approve) {
      Endorsement<Wire> e = endorse request by d;
      perform WireFunds(e.amount_cents);
      emit Wired(f"wired {e.amount_cents} cents on boss's attestation");
    } else if (d.committed == Deny) {
      emit Wired("denied by boss");
    } else {
      emit Wired("no ruling — withheld (fail closed)");
    }
  }
}

when (Wired w) { say(f"outcome: {w.note}"); }

spawn Treasurer t;
awake t;
