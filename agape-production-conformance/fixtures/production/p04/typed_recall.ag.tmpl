enum Answer { Correct, Wrong }

agent Rememberer {
  mem facts {
    type text;
    modality opaque;
    scope project;
    retention durable;
  }
  on awake {
    facts <- "{{FACT}}";
    text[] recalled = facts -> "{{QUERY}}";
    Credence<Answer> answer = self <- f"Use this recalled evidence to answer {{QUERY}}: ${recalled}";
    Decision<Answer> decision = decide answer by confidence 0.5;
  }
}

spawn Rememberer stable_agent;
awake stable_agent;
