// Preserve the original source's standing sensor so the resumed singleton is
// allocated at the same Spawned tick within the explicit session lineage.
prompt text question;

agent Rememberer {
  mem notes {
    type text;
    modality opaque;
    scope project;
    retention durable;
  }
  on awake {
    text[] recalled = notes -> "{{QUERY}}";
    self <- f"Recalled memory with its origin context: ${recalled}";
    forget notes;
  }
}

spawn Rememberer remembered_agent;
awake remembered_agent;
