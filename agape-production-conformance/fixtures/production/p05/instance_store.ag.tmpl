agent Worker(text primary, text secondary) {
  mem notes {
    type text;
    modality opaque;
    scope project;
    retention durable;
  }
  mem scratch {
    type text;
    modality opaque;
    scope project;
    retention durable;
  }
  on awake {
    notes <- f"${primary}";
    scratch <- f"${secondary}";
  }
}

spawn Worker first_agent("{{FIRST_PRIMARY}}", "{{FIRST_SECONDARY}}");
spawn Worker second_agent("{{SECOND_PRIMARY}}", "{{SECOND_SECONDARY}}");
awake first_agent;
awake second_agent;
