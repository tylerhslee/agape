// hello.ag — the Agape "hello world" (core kernel).
//
// A Greeter agent drafts a greeting, asks the provider to judge whether it is safe
// to publish, collapses that judgment with `decide`, endorses the exact draft, and —
// only inside the committed `Publish` branch, where the endorsement is the settled
// draft — performs the consequential `Announce` action. The whole trusted kernel:
//
//   testimony -> Credence<Verdict> -> Decision<Verdict> -> Endorsement<text> -> granted sink -> ledger

enum Verdict { Publish, Revise }

action Announce(text body);     // a consequential sink (needs the `perform Announce` power)
event  Revised(text note);      // a plain event (no power needed)

agent Greeter grants { perform Announce } {
  on awake {
    text draft = "hello, world";

    // Cognition: a graded judgment over the closed enum `Verdict`.
    Credence<Verdict> v = self <- f"is this greeting safe to publish: ${draft}";

    // Collapse the judgment to a sealed Decision by a local rule, then endorse the exact draft.
    Decision<Verdict>  d = decide v by confidence 0.8;

    // Branch on the committed verdict. `e` is the settled draft, sink-admissible only in the
    // committed `Publish` branch; the raw `draft` never becomes settled.
    if (d.committed == Publish) {
      Endorsement<text>  e = endorse draft by d;
      perform Announce(e);
    } else if (d.committed == Revise) {
      Endorsement<text>  e = endorse draft by d;
      emit Revised("held for revision");
    } else {
      emit Revised("uncertain — escalated");
    }

    say("greeter finished");
  }
}

spawn Greeter g;
awake g;
