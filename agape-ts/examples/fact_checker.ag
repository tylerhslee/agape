// fact_checker.ag - prompt -> atomic claim plan -> parallel verification -> publish decision.
//
// The first provider call returns a coherent structured claim plan: a single subject
// plus an array of atomic claims that could have been extracted from one long draft.
// Each claim is verified by the same agent through `claims |> verifyClaim`. The pipe
// runs one async path per claim: each path is sequential internally (search, then
// judge), while the paths overlap. With n claims and k verification reaches per claim,
// work is O(nk), and latency/span is O(k) — O(1) LLM rounds when k is fixed.
//
// The final publish/revise/abstain decision consumes the claim plan AND the recorded
// verification rows. If the answer is published, the endorsed PublishedAnswer always
// carries both natural-language prose and a structured JSON audit for every checked claim.

prompt text question;

// §6b the world interface: `Search` is an outbound act, wired to a catalog effector in agape.toml
// ([actions.Search] tool="web_search" result_event="SearchEvidence"); the reply lands as the event.
action Search(text q);
event SearchEvidence(text hits);

enum ClaimKind { Factual, Opinionated }
enum Grounding { Grounded, Weak, Unsupported }
enum PublishDecision { Publish, Revise, Abstain }

struct AtomicClaim {
  claim_id: text,
  statement: text,
  kind: ClaimKind,
  role: text
}

struct ClaimBundle {
  subject: text,
  claims: AtomicClaim[],
  first: AtomicClaim,
  second: AtomicClaim,
  third: AtomicClaim
}

struct Verification {
  claim_id: text,
  claim: text,
  claim_kind: ClaimKind,
  verdict: Grounding,
  evidence: text,
  note: text
}

struct VerificationAudit {
  subject: text,
  claims: Verification[],
  first: Verification,
  second: Verification,
  third: Verification
}

struct PublishedAnswer {
  prose: text,
  verification: VerificationAudit
}

action PublishAnswer(PublishedAnswer answer);
event ClaimVerified(Verification result);
event FinalAnswer(text status, VerificationAudit verification);

Verification verifyClaim(AtomicClaim claim) {
  // the claim statement is model-generated (raw): under the uniform sink rule it may not leave the
  // process un-endorsed (§6b anti-exfiltration), so per-claim grounding is judged from context.
  text evidence = self <- f"summarize any grounding evidence you can recall for this claim: {claim.statement}";

  Credence<Grounding> grounded =
    self <- f"Dummy fact-check criteria: mark Grounded if the search evidence supports the claim, Weak if it is opinionated but plausibly grounded, Unsupported otherwise. Claim kind: {claim.kind}. Claim: {claim.statement}. Search evidence: {evidence}";
  Decision<Grounding> d = decide grounded by confidence 0.75;

  Verification result = Verification {
    claim_id: claim.claim_id,
    claim: claim.statement,
    claim_kind: claim.kind,
    verdict: Unsupported,
    evidence: evidence,
    note: "fact checker abstained, so the claim is treated as unsupported"
  };

  if (d.committed == Grounded) {
    result = Verification {
      claim_id: claim.claim_id,
      claim: claim.statement,
      claim_kind: claim.kind,
      verdict: Grounded,
      evidence: evidence,
      note: "search evidence supports the claim under the dummy criteria"
    };
  } else if (d.committed == Weak) {
    result = Verification {
      claim_id: claim.claim_id,
      claim: claim.statement,
      claim_kind: claim.kind,
      verdict: Weak,
      evidence: evidence,
      note: "claim is opinionated or only partially supported under the dummy criteria"
    };
  } else if (d.committed == Unsupported) {
    result = Verification {
      claim_id: claim.claim_id,
      claim: claim.statement,
      claim_kind: claim.kind,
      verdict: Unsupported,
      evidence: evidence,
      note: "search evidence does not support the claim under the dummy criteria"
    };
  }

  emit ClaimVerified(result);
  say(f"verification: {result.claim} -> {result.verdict}");
  return result;
}

agent FactChecker grants { perform Search, perform PublishAnswer } {
  when (Prompt p about question) {
    text user_prompt = p.text;

    // the user's question is settled by origin (§5b), so it may drive the wired Search directly —
    // a foreground perform binding (§6b): the reply is the SearchEvidence event's payload.
    text background = perform Search(user_prompt) expires 5;

    ClaimBundle plan =
      self <- f"Create a coherent claim plan for one natural-language answer. Return a single subject and exactly three atomic claims. The claims array is the JSON-style extraction from the imagined long answer; first, second, and third must mirror those same three claims in order so this alpha kernel can fan them out as events. Each claim must be small, individually checkable, and tagged as Factual or Opinionated. User request: {user_prompt}. Background evidence: {background}";

    Verification[] verification_rows = plan.claims |> verifyClaim;

    PublishedAnswer answer =
      self <- f"Synthesize a user-facing answer from this atomic claim plan, not from a hidden draft. The prose must combine all three atomic claims into one coherent natural-language response about the plan subject. The verification field is a structured JSON object with the subject, a claims array, and first/second/third audit slots; include every generated claim with claim_id, claim, claim_kind, verdict, evidence, and note from the matching verification rows. Claim plan: {plan}. Verification rows: {verification_rows}";

    Credence<PublishDecision> readiness =
      self <- f"Decide whether to Publish, Revise, or Abstain. Criteria: the candidate prose must faithfully synthesize the claim plan; the structured verification audit must disclose every checked claim and its verdict; the fact-check verdicts are mandatory evidence for the decision. Publish is allowed only when weak or unsupported claims are removed, caveated, or honestly disclosed in the audit. Choose Revise if the prose overstates a weak or unsupported claim, omits a verification result, or needs another pass. Choose Abstain if the checked claims are too unsupported to answer responsibly. Claim plan: {plan}. Verification rows: {verification_rows}. Candidate answer: {answer}";
    Decision<PublishDecision> d = decide readiness by confidence 0.8;

    if (d.committed == Publish) {
      Endorsement<PublishedAnswer> approved = endorse answer by d;
      perform PublishAnswer(approved);
      emit FinalAnswer("published", answer.verification);
      say(approved);
    } else if (d.committed == Revise) {
      emit FinalAnswer("needs revision", answer.verification);
      say(f"revision required before publication\n{answer.verification}");
    } else {
      emit FinalAnswer("abstained", answer.verification);
      say(f"answer held for review\n{answer.verification}");
    }
  }
}

spawn FactChecker checker;
awake checker;
