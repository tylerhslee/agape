{
  "name": "agape-ts",
  "private": true,
  "type": "module",
  "version": "1.0.0-alpha.2026.7.11.3",
  "description": "A TypeScript compiler + runtime for the Agape core kernel (SPEC.md v1.0.0-alpha.2026.7.11.3). Embedded in Agape Studio.",
  "bin": {
    "agape-ts": "src/cli.ts"
  },
  "scripts": {
    "run": "tsx src/cli.ts",
    "hello": "tsx src/cli.ts run examples/hello.ag",
    "studio": "tsx src/cli.ts studio",
    "test": "vitest run",
    "test:cert": "vitest run test/certification.test.ts",
    "test:core": "vitest run test/kernel.test.ts test/memory.test.ts test/certification.test.ts",
    "typecheck": "tsc --noEmit",
    "version:check": "node ../scripts/check-version.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@google/genai": "latest",
    "openai": "latest"
  },
  "devDependencies": {
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "^2.1.9",
    "@types/node": "latest"
  }
}
